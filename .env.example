# Groq API Key for Whisper speech-to-text and Llama highlight detection
# Obtain a free key at: https://console.groq.com/keys
GROQ_API_KEY=

# Speech-to-Text Model (default: whisper-large-v3)
# Supported options: whisper-large-v3, whisper-large-v3-turbo
TRANSCRIPTION_MODEL=whisper-large-v3

# LLM for highlight detection (default: llama-3.3-70b-versatile)
# Supported options: llama-3.3-70b-versatile, llama-3.1-8b-instant
HIGHLIGHT_MODEL=llama-3.3-70b-versatile

# Maximum upload size in MB (default: 500)
MAX_UPLOAD_MB=500

# Directory for media and persistent JSON database (default: ./data)
DATA_DIR=./data

# Optional custom FFmpeg / FFprobe paths (leave blank to use bundled ffmpeg-static)
FFMPEG_PATH=
FFPROBE_PATH=
